<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/sessionViewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.healassist.app.camera.OverlayView
        android:id="@+id/sessionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Таймер отдыха по центру -->
    <TextView
        android:id="@+id/restTimerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@android:color/white"
        android:textSize="80sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        android:visibility="gone" />

    <!-- ВЕРХНЯЯ ПАНЕЛЬ: Круги с номерами упражнений -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/session_panel_scrim"
        android:paddingVertical="12dp"
        android:paddingHorizontal="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Упражнение 1 (Кулак) -->
            <TextView
                android:id="@+id/circle1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/circle_active"
                android:gravity="center"
                android:text="1"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Упражнение 2 (Заглушка) -->
            <TextView
                android:id="@+id/circle2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/circle_inactive"
                android:gravity="center"
                android:text="2"
                android:textColor="#CCCCCC"
                android:textSize="18sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Упражнение 3 (Заглушка) -->
            <TextView
                android:id="@+id/circle3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/circle_inactive"
                android:gravity="center"
                android:text="3"
                android:textColor="#CCCCCC"
                android:textSize="18sp" />

            <!-- Упражнение 4 (Заглушка) -->
            <TextView
                android:id="@+id/circle4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/circle_inactive"
                android:gravity="center"
                android:text="4"
                android:textColor="#CCCCCC"
                android:textSize="18sp" />

            <!-- Упражнение 5 (Заглушка) -->
            <TextView
                android:id="@+id/circle5"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/circle_inactive"
                android:gravity="center"
                android:text="5"
                android:textColor="#CCCCCC"
                android:textSize="18sp" />

            <!-- Упражнение 6 (Заглушка) -->
            <TextView
                android:id="@+id/circle6"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/circle_inactive"
                android:gravity="center"
                android:text="6"
                android:textColor="#CCCCCC"
                android:textSize="18sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- НИЖНЯЯ ПАНЕЛЬ: Название, счетчики и пауза -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/session_panel_scrim">

        <TextView
            android:id="@+id/sessionTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sessionProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFEB3B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/sessionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:paddingTop="4dp" />

        <Button
            android:id="@+id/sessionPauseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#F44336"
            android:textColor="@android:color/white"
            android:text="Выход" />
    </LinearLayout>
</FrameLayout>